function TestoHUB:DisableAll()
	for _, toggleData in pairs(TestoHUB.Toggles) do
		if toggleData.Value then
			toggleData.Value = false
		end
		if typeof(toggleData.Callback) == "function" then
			pcall(toggleData.Callback, false)
		end
	end
end

