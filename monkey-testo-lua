TestoHUB:AddToggle(adminAbuse, "AUTO TELEPORT BANANAS", "SOLO USAR EN ADMIN ABUSE", function(state)
	bananaTeleportActive = state
	if state then
		startBananaTeleport()
	else
		stopBananaTeleport()
	end
end)

----------------------------------------------------------------
-- AUTO TELEPORT TACOS
----------------------------------------------------------------

local tacoTeleportActive = false
local tacoTeleportTask = nil
local tacoIndex = 1

local function getTacos()
	local folder = workspace:FindFirstChild("Tacos")
	if not folder then return {} end
	
	local objects = {}
	for _, child in ipairs(folder:GetChildren()) do
		if child:IsA("BasePart") or child:IsA("Model") then
			table.insert(objects, child)
		end
	end
	return objects
end

local function getTacoPosition(obj)
	if obj:IsA("BasePart") then
		return obj.Position
	elseif obj:IsA("Model") then
		local primary = obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildWhichIsA("BasePart")
		if primary then
			return primary.Position
		end
	end
	return nil
end

local function teleportToTaco()
	local tacos = getTacos()
	if #tacos == 0 then return end
	
	if tacoIndex > #tacos then
		tacoIndex = 1
	end
	
	local target = tacos[tacoIndex]
	local pos = getTacoPosition(target)
	
	if pos then
		local character = localPlayer.Character
		if character then
			local rootPart = character:FindFirstChild("HumanoidRootPart")
			if rootPart then
				rootPart.CFrame = CFrame.new(pos + Vector3.new(0, 5, 0))
			end
		end
	end
	
	tacoIndex = tacoIndex + 1
end

local function startTacoTeleport()
	if tacoTeleportTask then
		tacoTeleportTask:Disconnect()
		tacoTeleportTask = nil
	end
	
	local tacos = getTacos()
	if #tacos == 0 then return end
	
	tacoIndex = 1
	teleportToTaco()
	
	tacoTeleportTask = runService.Heartbeat:Connect(function()
		if not tacoTeleportActive then return end
		teleportToTaco()
	end)
end

local function stopTacoTeleport()
	if tacoTeleportTask then
		tacoTeleportTask:Disconnect()
		tacoTeleportTask = nil
	end
	tacoIndex = 1
end

TestoHUB:AddToggle(adminAbuse, "AUTO TELEPORT TACOS", "Teletransporta a todos los Tacos", function(state)
	tacoTeleportActive = state
	if state then
		startTacoTeleport()
	else
		stopTacoTeleport()
	end
end)

getgenv().TestoHUB = TestoHUB

return TestoHUB
